---
import Base from '@/layouts/Base.astro';
---

<Base title="Página não encontrada | FastInvest" description="A página que você procurou não existe." noindex>
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6" aria-labelledby="erro-titulo">
    <p class="sobretitulo">Erro 404</p>
    <h1 id="erro-titulo" class="titulo-secao">Página não encontrada</h1>
    <p class="mt-6 text-lg text-muted-foreground">O endereço não existe ou mudou de lugar. Volte ao início ou escolha uma página no menu.</p>
    <p class="mt-8"><a href="/" class="botao botao-amarelo botao-grande press">Voltar ao início</a></p>
  </section>
</Base>
