---
import Base from '@/layouts/Base.astro';
import Titulo from '@/components/Titulo.astro';

const planos = [
  {
    nome: 'Gold',
    novo: false,
    itens: [
      { t: '30 dias de plano', dica: 'Isso mesmo, são 30 dias no total.' },
      { t: '3 tipos de notícias diferentes', dica: 'São 3 tipos de notícias.' },
      { t: 'Relatórios' },
      { t: 'Contato com analista' },
    ],
    preco: 'R$50,00',
  },
  {
    nome: 'Platinum',
    novo: true,
    itens: [
      { t: '60 dias de plano' },
      { t: '6 tipos de notícias diferentes' },
      { t: 'Relatórios mais complexos' },
      { t: 'Contato com especialistas' },
    ],
    preco: 'R$ 100,00',
  },
];
---

<Base title="Planos | FastInvest" description="Planos Gold e Platinum da FastInvest. Preços e condições são exemplos de um site de demonstração; nenhuma compra real é feita.">
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6" aria-labelledby="planos-titulo">
    <Titulo sobre="Seu plano, seu investimento"><span id="planos-titulo">Escolha o seu Plano</span></Titulo>
    <p class="aviso-demo mx-auto mb-8 max-w-3xl">
      Demonstração: os planos e os preços abaixo são exemplos e não existe cobrança nem compra de verdade.
    </p>
    <ul class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2">
      {planos.map((p, i) => (
        <li class="cartao cartao-plano flex flex-col p-6" data-reveal style={`--i: ${i}`}>
          <h2 class="text-3xl font-semibold">
            {p.nome}
            {p.novo && <span class="etiqueta ml-2">Novo</span>}
          </h2>
          <ul class="mt-4 space-y-2">
            {p.itens.map((it) => (
              <li class="flex gap-2">
                <span aria-hidden="true">→</span>
                <span>{it.t}{it.dica && <span class="block text-sm text-muted-foreground">{it.dica}</span>}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-6">
            <a href="/inscricao/" class="botao botao-amarelo botao-grande press grow sm:grow-0">Comprar Plano</a>
            <p class="text-2xl font-semibold">{p.preco}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
