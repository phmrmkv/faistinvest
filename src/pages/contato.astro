---
import Base from '@/layouts/Base.astro';
import Titulo from '@/components/Titulo.astro';
import Faq from '@/components/Faq.astro';
import { contatoDemo } from '@/data/site';
---

<Base title="Contato | FastInvest" description="Fale com a FastInvest: formulário de contato de demonstração. Os dados de contato são fictícios e nada é enviado.">
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6" aria-labelledby="contato-titulo">
    <Titulo sobre="Possui alguma dúvida?"><span id="contato-titulo">Fale Conosco</span></Titulo>
    <p class="aviso-demo mb-6">
      <strong>Demonstração.</strong> Os dados de contato desta página são fictícios e o formulário não envia mensagem nenhuma.
    </p>
    <div class="grid gap-8 lg:grid-cols-2">
      <form class="cartao p-5 sm:p-6" method="dialog" data-form-demo data-sucesso="Demonstração: a mensagem não foi enviada nem guardada. Os campos foram limpos.">
        <div>
          <label class="rotulo" for="clienteNome">Nome</label>
          <input class="campo" type="text" id="clienteNome" name="nome" required autocomplete="off" aria-describedby="erro-clienteNome" />
          <p class="erro-campo" id="erro-clienteNome"></p>
        </div>
        <div>
          <label class="rotulo" for="clienteEmail">Email</label>
          <input class="campo" type="email" id="clienteEmail" name="email" required autocomplete="off" aria-describedby="erro-clienteEmail" />
          <p class="erro-campo" id="erro-clienteEmail"></p>
        </div>
        <div>
          <label class="rotulo" for="clienteMensagem">Mensagem</label>
          <textarea class="campo" id="clienteMensagem" name="mensagem" rows="4" required minlength="10" aria-describedby="erro-clienteMensagem"></textarea>
          <p class="erro-campo" id="erro-clienteMensagem"></p>
        </div>
        <button type="submit" class="botao botao-amarelo press mt-1">Enviar Mensagem</button>
        <div class="estado-envio mt-4" role="status" tabindex="-1" hidden data-estado></div>
      </form>

      <div>
        <h2 class="text-sm font-semibold tracking-wide uppercase">Nosso endereço</h2>
        <p class="mt-2 text-muted-foreground">
          Endereço fictício: São Paulo. O mapa do original foi retirado para o site não carregar serviços de terceiros em um projeto de estudo.
        </p>

        <h2 class="mt-6 mb-2 border-b border-primary pb-1 text-sm font-semibold tracking-wide uppercase">Dados de contato (demonstração)</h2>
        <ul class="text-muted-foreground">
          <li>{contatoDemo.email}</li>
          <li>{contatoDemo.telefone}</li>
          <li>{contatoDemo.horario}</li>
        </ul>

        <h2 class="mt-6 mb-2 border-b border-primary pb-1 text-sm font-semibold tracking-wide uppercase">Redes sociais (demonstração)</h2>
        <ul class="text-muted-foreground">
          {contatoDemo.redes.map((r) => <li>{r}: perfil de exemplo, ainda não existe</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-muted py-8" aria-labelledby="duvidas">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Titulo sobre="Ainda está com dúvidas?" nivel={2}><span id="duvidas">Perguntas Frequentes</span></Titulo>
      <Faq />
      <p class="mt-8 text-center text-sm tracking-wide text-muted-foreground uppercase">Use o formulário acima para mais dúvidas</p>
    </div>
  </section>
</Base>
