---
import '@fontsource-variable/inter';
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import TemaAlternar from '@/components/TemaAlternar.astro';
import Dialogos from '@/components/Dialogos.astro';
import CreditoPHMR from '@/components/CreditoPHMR.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL('/og-image.png', Astro.site);
const links = [
  { href: '/#como-funciona', texto: 'Como funciona' },
  { href: '/#recursos', texto: 'O que ele faz' },
  { href: '/#perguntas', texto: 'Dúvidas' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Tema antes da primeira pintura (sem piscar): preferência salva ou, sem ela, a do sistema.
      (function () {
        var d = document.documentElement;
        var m = window.matchMedia('(prefers-color-scheme: dark)');
        function salvo() {
          try { var v = localStorage.getItem('faistinvest-tema'); return v === 'dark' || v === 'light' ? v : null; } catch (e) { return null; }
        }
        d.dataset.theme = salvo() || (m.matches ? 'dark' : 'light');
        function mudou(e) { if (!salvo()) d.dataset.theme = e.matches ? 'dark' : 'light'; }
        if (m.addEventListener) m.addEventListener('change', mudou);
        else { var ml = /** @type {any} */ (m); if (ml.addListener) ml.addListener(mudou); }
        d.classList.add('js');
      })();
    </script>
    <meta name="theme-color" content="#f5f5f7" />
    <script is:inline>
      if (document.documentElement.dataset.theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#121116');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="fAIstInvest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="fAIstInvest: seus investimentos, explicados. Projeto em desenvolvimento." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
      >Pular para o conteúdo</a
    >
    <div class="faixa-aviso">
      <div class="miolo"><span class="faixa-ponto" aria-hidden="true"></span><span><b>Projeto em desenvolvimento.</b> Esta página é uma demonstração.</span></div>
    </div>
    <header class="cabecalho" data-cabecalho>
      <div class="miolo">
        <a href="/" aria-label="fAIstInvest, página inicial"><Logo /></a>
        <nav class="nav-links" aria-label="Principal">
          {links.map((l) => <a class="link-nav" href={l.href}>{l.texto}</a>)}
        </nav>
        <div class="acoes-topo">
          <button type="button" class="botao botao-primario botao-topo press" data-abrir="dialogo-lista">Lista de espera</button>
          <TemaAlternar />
          <button type="button" class="icone-botao menu-botao press js-so" aria-expanded="false" aria-controls="menu-painel" aria-label="Abrir menu" data-menu-botao>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </div>
      </div>
      <div class="menu-painel" id="menu-painel">
        <nav class="miolo" aria-label="Menu">
          {links.map((l) => <a href={l.href}>{l.texto}</a>)}
        </nav>
      </div>
    </header>
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <footer class="rodape">
      <div class="miolo">
        <a href="/" aria-label="fAIstInvest, início"><Logo /></a>
        <p>Produto em desenvolvimento pela PHMR Tech Solutions. Esta página é uma demonstração.</p>
        <CreditoPHMR fundo="tema" />
      </div>
    </footer>
    <Dialogos />
    <script>
      import '@/scripts/interacoes';
    </script>
    <script is:inline>
      // Reveal ao rolar (docs/transicoes.md). Inline de propósito: se fosse um arquivo
      // separado e ele falhasse, o conteúdo com data-reveal ficaria invisível.
      (function () {
        var alvos = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          alvos.forEach(function (el) { el.classList.add('is-shown'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-shown'); io.unobserve(e.target); }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );
        alvos.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
