---
import { Picture } from 'astro:assets';
import logo from '@/assets/logoFI.png';
import TemaAlternar from '@/components/TemaAlternar.astro';
import MenuMobile from '@/components/MenuMobile';
import { noticias, linksPrincipais } from '@/data/site';

interface Props {
  atual: string;
}

const { atual } = Astro.props;
const naNoticia = noticias.some((n) => n.href === atual);
const pagina = (href: string) => (atual === href ? 'page' : undefined);
---

<header class="cabecalho" data-cabecalho>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-1 sm:px-6">
    <a href="/" class="press -ml-1 flex min-h-11 items-center rounded-md px-1" aria-current={pagina('/')}>
      <Picture
        src={logo}
        alt="FastInvest, página inicial"
        formats={['avif', 'webp']}
        fallbackFormat="png"
        widths={[86, 130]}
        sizes="86px"
        loading="eager"
        class="h-12 w-auto"
      />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.9375rem]">
        <li>
          <details class="menu-noticias" data-menu-noticias>
            <summary class="link-nav" aria-current={naNoticia ? 'page' : undefined}>
              Notícias
              <svg class="ml-1.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg>
            </summary>
            <ul class="menu-noticias-painel">
              {noticias.map((n) => (
                <li><a href={n.href} class="link-drop" aria-current={pagina(n.href)}>{n.texto}</a></li>
              ))}
            </ul>
          </details>
        </li>
        {linksPrincipais.map((l) => (
          <li><a href={l.href} class="link-nav" aria-current={pagina(l.href)}>{l.texto}</a></li>
        ))}
        <li class="js-so"><button type="button" class="link-nav" data-abrir-login>Login</button></li>
        <li><a href="/inscricao/" class="botao botao-contorno-amarelo press md:ml-2" aria-current={pagina('/inscricao/')}>Inscreva-se</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <TemaAlternar rotuloEscuro="Mudar para o tema escuro" rotuloClaro="Mudar para o tema claro" />
      <MenuMobile
        client:media="(max-width: 767px)"
        atual={atual}
        noticias={noticias}
        links={linksPrincipais}
      />
    </div>

    <!-- Sem JavaScript no celular não há menu lateral: os links aparecem em linha -->
    <nav aria-label="Principal (sem JavaScript)" class="sem-js-so w-full md:hidden">
      <ul class="flex flex-wrap gap-x-1 pb-2 text-[0.9375rem]">
        {[...noticias, ...linksPrincipais, { href: '/inscricao/', texto: 'Inscreva-se' }].map((l) => (
          <li><a href={l.href} class="link-nav" aria-current={pagina(l.href)}>{l.texto}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
