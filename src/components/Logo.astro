---
// Logo tipográfico PROVISÓRIO: marca "F" com um traço de marca-texto + nome com o "ai" destacado.
interface Props { class?: string }
const { class: classe = '' } = Astro.props;
---
<span class:list={['logo', classe]}>
  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect class="logo-m-fundo" width="64" height="64" rx="14"></rect>
    <rect class="logo-m-letra" x="19" y="11" width="8" height="35"></rect>
    <rect class="logo-m-letra" x="19" y="11" width="27" height="8"></rect>
    <rect class="logo-m-letra" x="19" y="26" width="19" height="7"></rect>
    <rect x="15" y="50" width="34" height="5" rx="2.5" fill="#f7d54a"></rect>
  </svg>
  <span aria-hidden="true">f<span class="logo-ai">AI</span>stInvest</span>
  <span class="sr-only">fAIstInvest</span>
</span>
