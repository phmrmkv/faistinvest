---
import Titulo from '@/components/Titulo.astro';

interface Props {
  sobre: string;
  bolsa: string;
}
const { sobre, bolsa } = Astro.props;
const linhas = Array.from({ length: 10 }, (_, i) => i);
---

<section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6" aria-labelledby="titulo-noticias">
  <Titulo sobre={sobre}><span id="titulo-noticias">Descubra todas as novidades da {bolsa}</span></Titulo>
  <p class="aviso-demo mb-6">
    Notícias de exemplo: as linhas abaixo são modelos de demonstração, sem links reais e sem cotações ou números de mercado.
    Nada aqui é recomendação de investimento.
  </p>
  <div class="overflow-x-auto" role="region" aria-label={`Tabela de notícias de exemplo: ${bolsa}`} tabindex="0" data-reveal>
    <table class="tabela">
      <caption class="sr-only">Notícias de exemplo: {bolsa}</caption>
      <thead>
        <tr>
          <th scope="col">Data</th>
          <th scope="col">Autor</th>
          <th scope="col">Local</th>
          <th scope="col">Link</th>
        </tr>
      </thead>
      <tbody>
        {linhas.map(() => (
          <tr>
            <th scope="row"><time datetime="2020-10-31">31/10/2020</time></th>
            <td>Redação FastInvest (exemplo)</td>
            <td>SÃO PAULO</td>
            <td class="text-muted-foreground">Notícia de exemplo, sem link</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
