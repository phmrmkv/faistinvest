---
interface Props {
  sobre: string;
  nivel?: 1 | 2;
  class?: string;
}
const { sobre, nivel = 1, class: classe = 'my-10' } = Astro.props;
const Tag = nivel === 1 ? 'h1' : 'h2';
---

<div class={`text-center ${classe}`} data-reveal>
  <span class="sobretitulo">{sobre}</span>
  <Tag class="titulo-secao"><slot /></Tag>
</div>
