---
import { Picture } from 'astro:assets';
import nasdaq from '@/assets/nasdaq.jpg';
import b3 from '@/assets/b3.jpg';
import bitcoin from '@/assets/bitcoin.jpg';

// id mantido do original (#carouselFast)
const slides = [
  { img: nasdaq, titulo: 'Nasdaq', href: '/nasdaq/', alt: 'Fachada de prédios iluminados com painéis de anúncios, entre eles o painel da Nasdaq, vista de baixo para cima à noite' },
  { img: b3, titulo: 'Bovespa', href: '/bovespa/', alt: 'Escultura de um touro de bronze usando óculos escuros, diante de um prédio com cartazes azuis da bolsa brasileira B3' },
  { img: bitcoin, titulo: 'Bitcoins', href: undefined, alt: 'Moeda digital com o símbolo do bitcoin sobre uma placa de circuito iluminada' },
];
const total = slides.length;
---

<div
  id="carouselFast"
  class="carrossel"
  data-carrossel
  data-rodando="true"
  role="region"
  aria-roledescription="carrossel"
  aria-label="Destaques dos mercados"
>
  <div class="carrossel-slides" data-slides aria-live="off">
    {slides.map((s, i) => (
      <div
        class="carrossel-slide"
        data-slide
        data-ativo={i === 0 ? 'true' : 'false'}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} de ${total}: ${s.titulo}`}
      >
        <Picture
          src={s.img}
          alt={s.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 600, 728]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          quality={72}
          loading={i === 0 ? 'eager' : 'lazy'}
          class="block aspect-video w-full object-cover"
        />
        <div class="carrossel-legenda">
          <p class="text-2xl font-semibold sm:text-4xl">
            {s.href ? <a href={s.href} class="hover:underline hover:underline-offset-4">{s.titulo}</a> : s.titulo}
          </p>
        </div>
      </div>
    ))}
  </div>

  <div class="js-so">
    <button type="button" class="carrossel-btn carrossel-ant press" data-anterior aria-label="Destaque anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button type="button" class="carrossel-btn carrossel-prox press" data-proximo aria-label="Próximo destaque">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
    <div class="carrossel-controles">
      <button type="button" class="carrossel-btn press" data-pausa aria-label="Pausar a troca automática dos destaques">
        <svg class="ic-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        <svg class="ic-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z"></path></svg>
      </button>
    </div>
    <div class="carrossel-pontos">
      {slides.map((s, i) => (
        <button type="button" class="carrossel-ponto" data-ponto aria-label={`Ir para o destaque ${i + 1}: ${s.titulo}`} aria-current={i === 0 ? 'true' : undefined}>
          <span></span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import '@/scripts/carrossel';
</script>
